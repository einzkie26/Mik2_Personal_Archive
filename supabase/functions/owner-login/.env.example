# Set these using Supabase Dashboard > Edge Functions > Secrets.
# This is a template; do not commit a file containing real secret values.
# Use the Google Cloud project ID that owns the site key, not the site key itself
# or the Supabase project reference. Enable the reCAPTCHA Enterprise API there.
RECAPTCHA_PROJECT_ID=mikhaiarchive
# Create a server API key restricted to the reCAPTCHA Enterprise API.
RECAPTCHA_ENTERPRISE_API_KEY=your-private-google-cloud-api-key
# Public value. This matches the browser key and the shared configuration.
RECAPTCHA_SITE_KEY=6LeGQwQuAAAAAECnTksKT8FGfz0CUPIrUs1UF9zW
RECAPTCHA_ALLOWED_HOSTNAMES=archive.example.com,www.archive.example.com
ARCHIVE_ALLOWED_ORIGINS=https://archive.example.com,https://www.archive.example.com
RECAPTCHA_MIN_SCORE=0.5

# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically in deployed Edge Functions.
# For local development, add localhost to the registered Google domains,
# add localhost to RECAPTCHA_ALLOWED_HOSTNAMES, and add the exact development
# URL (including its port) to ARCHIVE_ALLOWED_ORIGINS.
